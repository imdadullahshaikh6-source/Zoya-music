# Copy: cp .env.example .env   phir values bharo. (.env kabhi git me mat daalna)

# ── Telegram (zaroori) ──
BOT_TOKEN=
API_ID=
API_HASH=
STRING_SESSION=          # assistant account ka pyrogram string session
OWNER_ID=                # numeric Telegram ID (e.g. 8373739674)

# ── Database (zaroori) ──
MONGO_DB_URI=

# ── Links / branding ──
BOT_LINK=
START_IMG=
SUPPORT_CHAT=
UPDATES_CHANNEL=

# ── Music APIs ──
YT_API_KEY=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
API_FIRST=innertube      # innertube | ritesh | dump
YT_PROXIES=

# ── Local API (isi container ke andar chalti hai) ──
LOCAL_API_KEY=
# LOCAL_API_ENABLED=1
# LOCAL_API_PORT=8787
